#include <stdio.h>

double average(int arr[], int size)
{
    int i, sum = 0;

    if (size == 0)
        return 0.0;

    for (i = 0; i < size; i++)
    {
        sum = sum + arr[i];
    }

    return (double)sum / size;
}

int main(void)
{
    int arr[] = {10, 20, 30, 40, 50};
    int size = 5;

    printf("Average = %.2f\n", average(arr, size));

    return 0;
}
